# Copy this file to .env in this folder (same directory as package.json).
# https://www.pricecharting.com/subscriptions -> API/Download for token.

PRICECHARTING_TOKEN=

# Private VPS API (scraped PC cache + /v1/compare). Match server API_KEY.
PC_API_BASE=
PC_API_KEY=

# https://developer.ebay.com/ - create a keyset with Browse API (buy scope implied).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
