# Copy to .env on the VPS and fill in secrets.

# Postgres (docker-compose)
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# API (required)
API_KEY=generate_a_long_random_string
API_PORT=3001

# Crawler
CRAWLER_ENABLED=true
GLOBAL_PAGES_PER_DAY=1000
US_SHARE=0.5
UK_SHARE=0.5
MIN_DELAY_MS=8000
MAX_DELAY_MS=45000

# Optional: override default sold-search seeds (Pokémon TCG US / broad UK)
# US_SEED_URL=https://www.ebay.com/sch/i.html?_sacat=31392&LH_Sold=1&LH_Complete=1&_ipg=60&rt=nc
# UK_SEED_URL=https://www.ebay.co.uk/sch/i.html?_sacat=0&LH_Sold=1&LH_Complete=1&_ipg=60&rt=nc
