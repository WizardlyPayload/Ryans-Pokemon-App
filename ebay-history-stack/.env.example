# Copy to .env on the VPS and fill in secrets.

# Postgres (docker-compose)
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# API (required)
API_KEY=generate_a_long_random_string
API_PORT=3001

# Crawler
CRAWLER_ENABLED=true
GLOBAL_PAGES_PER_DAY=1000
US_SHARE=0.5
UK_SHARE=0.5
MIN_DELAY_MS=8000
MAX_DELAY_MS=45000

# Optional: send Playwright through a proxy (e.g. HTTP/SOCKS on your home PC — see docs/SETUP.md)
# CRAWLER_PROXY_SERVER=http://100.x.y.z:8888
# CRAWLER_PROXY_USER=
# CRAWLER_PROXY_PASS=

# Homepage visit before search URL (default on). Set false to save time.
# WARMUP_EBAY_HOME=true

# Optional: ms pause before opening eBay
# PRE_NAV_MIN_MS=1200
# PRE_NAV_MAX_MS=5000

# Optional: override default sold-search seeds (Pokémon TCG US / broad UK)
# US_SEED_URL=https://www.ebay.com/sch/i.html?_sacat=31392&LH_Sold=1&LH_Complete=1&_ipg=60&rt=nc
# UK: do not use _sacat=0 (eBay UK → /b/0/ error page). Default is keyword sold search.
# UK_SEED_URL=https://www.ebay.co.uk/sch/i.html?_nkw=pokemon+card&LH_Sold=1&LH_Complete=1&_ipg=60&rt=nc
